# Track ONLY the runnable code — ignore everything else.
# hopper*.lua + servers.txt are regenerated on the phone (setup.sh / autoupdate.sh).
# link.txt, token.txt, cmd/, inv/, logs, archive/, docs stay local to each machine.
*
!.gitignore
!.gitattributes
!agent.py
!autoupdate.sh
!setup.sh
!setup-vps.sh
!setup-vps.ps1
!monitor_adoptme.lua
!debug_adoptme_pets.lua
!README.md
!web/
!web/.gitignore
!web/server.py
!web/rejoin_listener.py
!web/seeder.py
!web/config.example.txt
!web/rejoin_listener.example.txt
!web/test_trackstat.py
!web/requirements.txt
!web/README.md
!web/hoppers.example.json
!web/assets/
!web/assets/*
